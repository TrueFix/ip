# Copy to .env beside the downloaded deploy/compose.maxmind.yml.
# Both values are required. DB-IP fallback is included automatically.
MAXMIND_ACCOUNT_ID=YOUR_ACCOUNT_ID
MAXMIND_LICENSE_KEY=YOUR_LICENSE_KEY

# Optional API controls, not provider authentication.
# RATELIMIT_ENABLE=true
# Set false to disable all built-in limits and client tracking.
# RATE_LIMIT_RPM=300
# Run docker compose up -d after changes. Requires v0.1.4 or newer.
