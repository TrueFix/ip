# Version-controlled template only. Copy to .env; NEVER commit real credentials.
# Docker Compose reads .env. For local commands: set -a; . ./.env; set +a

# maxmind = MaxMind primary + DB-IP fallback; dbip = DB-IP only (no credentials).
GEOIP_PROVIDER=maxmind
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# Prefer mounted secrets for production. Set a value OR its _FILE, not both.
# MAXMIND_ACCOUNT_ID_FILE=/run/secrets/maxmind_account_id
# MAXMIND_LICENSE_KEY_FILE=/run/secrets/maxmind_license_key

# Optional third source in maxmind mode only: IPinfo Lite (free account required).
IPINFO_ENABLED=false
# IPINFO_TOKEN=
# IPINFO_TOKEN_FILE=/run/secrets/ipinfo_token
# Explicit approximation: use IPinfo's network operator name for connection.isp.
ISP_FROM_ASN=false

# No BASE_URL or DOCS_URL: links follow the request's host, port and scheme.
# Optional host allowlist; exact host[:port] values, comma-separated.
# ALLOWED_HOSTS=ip.mynk.org

# Local default: ./data. Docker always uses /data on a persistent named volume.
# DATA_DIR=./data
# To use a Docker host bind mount instead: DATA_VOLUME=/absolute/host/path

# Docker public listener: bind to loopback behind a host reverse proxy.
# Pin a published version for production; omit to use latest stable.
# IMAGE_TAG=v0.1.0
BIND_ADDRESS=127.0.0.1
PORT=8080

# Empty = trust no forwarding headers. Never trust all IPs/private networks.
TRUSTED_PROXIES=
PROXY_HEADER=X-Forwarded-For

# Strict rolling 60-second budget per client. Optional extra RPS/burst throttle.
RATE_LIMIT_RPM=300
# RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=20
RATE_LIMIT_MAX_CLIENTS=50000
UPDATE_INTERVAL=24h
CORS_ORIGIN=*
