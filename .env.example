# Advanced root compose.yml example. Copy to .env; never commit real credentials.
# For simpler source-specific examples, see deploy/env/ and DEPLOYMENT.md.
# All optional settings and defaults: docs/ENVIRONMENT.md.

# 1. DB-IP: no account, license key or token needed.
GEOIP_PROVIDER=dbip

# 2. MaxMind + DB-IP fallback: change GEOIP_PROVIDER to maxmind and set BOTH.
# MAXMIND_ACCOUNT_ID=YOUR_ACCOUNT_ID
# MAXMIND_LICENSE_KEY=YOUR_LICENSE_KEY

# 3. Optional IPinfo enrichment: requires MaxMind mode and a free IPinfo token.
# IPINFO_ENABLED=true
# IPINFO_TOKEN=YOUR_IPINFO_TOKEN
# ISP_FROM_ASN=true

# Optional deployment overrides. Omit to keep the safe defaults.
# UPDATE_INTERVAL=24h
# ALLOWED_HOSTS=ip.example.com
# TRUSTED_PROXIES=172.30.0.2/32
# PROXY_HEADER=X-Forwarded-For
# RATE_LIMIT_RPM=300
# Set RATE_LIMIT_RPM=0 to disable ALL built-in rate limits and client tracking.

# Advanced controls (root compose.yml only).
# RATE_LIMIT_RPS=5
# RATE_LIMIT_BURST=20
# RATE_LIMIT_MAX_CLIENTS=50000
# CORS_ORIGIN=*

# Mounted secrets: use a value OR its _FILE alternative, never both.
# Host ./secrets/ is mounted at /run/secrets/ in the root Compose updater.
# MAXMIND_ACCOUNT_ID_FILE=/run/secrets/maxmind_account_id
# MAXMIND_LICENSE_KEY_FILE=/run/secrets/maxmind_license_key
# IPINFO_TOKEN_FILE=/run/secrets/ipinfo_token
# GEOIPUPDATE_CONFIG_FILE=/run/secrets/GeoIP.conf

# Native binaries only; Compose does not forward these overrides.
# DATA_DIR=./data
# LISTEN_ADDR=:8080
# METRICS_ADDR=127.0.0.1:9090
